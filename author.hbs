{{!< default}}

{{!-- This is a workaround for author ghost error, see https://github.com/TryGhost/Ghost/issues/19681. Once they fix it it's possible to reuse index-content.hbs as other elements --}}

<main class="site-main gh-outer">
    {{!-- Adding the latest post in large preview but only if we're not in pagination (i.e. page 1) --}}
    <div class="gh-inner">
        {{#match @custom.showcase_post 'Latest Posted'}}
            {{^is "paged"}}
                {{#foreach posts limit="1"}}
                    {{> chapter/post-card class="post-card-showcased"}}
                {{/foreach}}
            {{/is}}
        {{else}}
            {{#match @custom.showcase_post 'Latest Featured'}}
                {{^is "paged"}}
                {{#author}}
                    {{#get "posts" include="tags, authors, tiers" filter="featured:true+authors:{{slug}}" limit="1" as |featured|}}
                        {{#if featured }}
                            {{#foreach featured}}
                                {{> chapter/post-card class="post-card-showcased"}}
                            {{/foreach}}
                        {{/if}}
                    {{/get}}
                {{/author}}
                {{/is}}
            {{/match}}
        {{/match}}

        <div class="gh-wrapper">
            <section class="gh-section">
                {{#match @custom.showcase_post 'Latest Posted'}}
                    <h2 class="gh-section-title">More issues</h2>
                {{else}}
                    {{#match @custom.showcase_post 'Latest Featured'}}
                        <h2 class="gh-section-title">More issues</h2>
                    {{/match}}
                {{/match}}
                <div class="post-feed gh-feed">
                    {{^is "paged"}}
                        {{#match @custom.showcase_post 'Latest Posted'}}
                            {{^is "paged"}}
                                {{#foreach posts from="2"}}
                                    {{> chapter/post-card}}
                                {{/foreach}}
                            {{/is}}
                        {{else}}
                            {{#foreach posts}}
                                {{> chapter/post-card}}
                            {{/foreach}}
                        {{/match}}
                    {{else}}
                        {{#foreach posts}}
                            {{> chapter/post-card}}
                        {{/foreach}}
                    {{/is}}
                </div>

                {{> base/pagination}}
                
            </section>

            {{#author}}
                {{> chapter/sidebar-author}}
            {{/author}}

        </div>
    </div>
</main>

{{> utility/index-duplicate-remover}}