{{!-- This is a partial file used to generate a post "card" which templates loop over to generate a list of posts. --}}

<article class="{{class}} post-card{{#match @custom.preview_layout 'Compact'}}{{#is "home"}} post-card-compact{{/is}}{{/match}}{{#match @custom.preview_layout 'Full'}}{{#if feature_image}} post-card-full{{/if}}{{/match}} {{post_class}}{{#unless access}} post-access-{{visibility}}{{/unless}}">
    {{#if feature_image}}
        {{#match @custom.preview_layout "Full"}}
            <a class="post-card-image-link" href="{{url}}">

                {{!-- This is a responsive image, it loads different sizes depending on device https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                <img class="post-card-image"
                    srcset="{{> utility/srcset}}"
                    sizes="(max-width: 1000px) 800px"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                />

                {{#unless access}}
                    {{^has visibility="public"}}
                        <div class="post-card-access">
                            <span class="ch-icon-container">{{> icons/lock}}</span>
                            {{#has visibility="members"}}
                                Members only
                            {{else}}
                                Paid-members only
                            {{/has}}
                        </div>
                    {{/has}}
                {{/unless}}
            </a>
        {{/match}}
    {{/if}}

    <div class="post-card-content">
        <a class="post-card-content-link" href="{{url}}">
            <header class="post-card-header">
                <h2 class="gh-article-title">
                    {{#unless access}}
                    {{^has visibility="public"}}
                        {{#unless feature_image}}
                            <span class="ch-icon-container">{{> icons/lock}}</span>
                        {{/unless}}
                    {{/has}}
                    {{/unless}}
                    {{title}}
                </h2>
            </header>
            
            <footer>
                {{#if excerpt}}
                    <div class="post-card-excerpt">{{excerpt}}</div>
                {{/if}}
                <div class="single-meta">
                    <time class="single-meta-item single-meta-date" datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time>
                    {{#if featured}}
                        <span class="single-meta-item single-meta-featured ch-icon-container"> {{> icons/fire class="ch-icon"}} Featured</span>
                    {{/if}}
                    {{#if reading_time}}
                        <span class="single-meta-item single-meta-length"> {{reading_time}}</span>
                    {{/if}}
                    {{#primary_tag}}
                        <span class="single-meta-item single-meta-tag post-tag"> {{name}}</span>
                    {{/primary_tag}}
                    {{#if @site.comments_enabled}}
                        <span class="single-meta-item single-meta-comment"> {{comment_count empty="Add a comment" autowrap="false"}}</span>
                    {{/if}}
                </div>
            </footer>
        </a>
    </div>

</article>