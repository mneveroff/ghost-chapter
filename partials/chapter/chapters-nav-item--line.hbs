{{!-- This helper is necessary to bypass ghost's {{get}} syntax restrictions, see https://forum.ghost.org/t/escape-get-context-in-handlebars-to-reference-the-post-context/44782/3 --}}
<article class="post-line-chapter post-line-chapter-{{type}} {{visibility}} {{post_class}} {{selected}}">
    <a href="{{url}}">{{title}}</a>
</article>